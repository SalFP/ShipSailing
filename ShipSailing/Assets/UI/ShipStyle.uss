.hud-container {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: column;
}

.hud-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 6px 12px;
    border-radius: 6px;
}